{
  "name": "vvpost",
  "version": "0.1.0",
  "private": true,
  "description": "VVPost: workspace local-first de documentação viva para backend, preparado para agentes de IA.",
  "license": "Apache-2.0",
  "author": "Victor Verdoodt",
  "main": "out/main/index.js",
  "bin": {
    "vvpost": "bin/vvpost.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:cli": "node scripts/build-cli-package.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "check:installer": "node scripts/check-installer-size.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p packages/core/tsconfig.json",
    "bench": "node scripts/bench-startup.mjs",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "docs:gifs": "node scripts/docs-gifs.mjs",
    "mcp": "node out/main/mcp.js",
    "vvpost": "node out/main/cli.js",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-all.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@azure/identity": "^4.14.0",
    "@azure/keyvault-secrets": "^4.11.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@peculiar/x509": "~2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vvpost/core": "file:packages/core",
    "@vvpost/schemas": "file:packages/schemas",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.17",
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "node-vault": "^0.13.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "undici": "^8.12.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1"
  }
}
