{
  "$schema": "https://vvpost.dev/schemas/v1/secrets-engine.json",
  "port": 4460,
  "mode": "localMock",
  "localMock": {
    "activeEnvironment": "env.development",
    "storageFile": ".vvpost/secrets.local.json"
  },
  "enterpriseProxy": {
    "provider": "azureKeyVault",
