{
  "$schema": "https://vvpost.dev/schemas/v1/environment.json",
  "id": "env.development",
  "name": "Development Environment",
  "variables": {
    "BASE_URL": {
      "type": "string",
      "value": "https://dev.api.empresa.com",
      "isSecret": false
    },
    "CLIENT_SECRET": {
      "type": "string",
      "value": "__REQUIRED_SECRET__",
      "isSecret": true,
      "description": "Chave secreta obtida no Keycloak",
      "placeholder": "Insira o secret do cliente aqui"
    }
  }
}
