{
  "name": "@vvpost/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "JSON Schemas v1 do VVPost (conector, ambiente, secrets engine, fluxo), tipos TypeScript gerados e validadores.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*.json": "./schemas/*.json"
  },
  "files": [
    "schemas",
    "src"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "check:generated": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "verify": "npm run check:generated && npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^6.0.3"
  }
}
