{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vvpost.dev/schemas/v1/secrets-engine.json",
  "title": "SecretsEngineConfig",
  "description": "Configuração do Secret Manager Engine em .vvpost/secrets-engine.json.",
  "type": "object",
  "required": ["mode"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "description": "Porta local em que o engine escuta.",
      "minimum": 1024,
      "maximum": 65535,
      "default": 4460
    },
    "mode": {
      "$ref": "#/$defs/mode"
    },
    "localMock": {
      "$ref": "#/$defs/localMock"
    },
    "enterpriseProxy": {
      "$ref": "#/$defs/enterpriseProxy"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "localMock" } } },
      "then": { "required": ["localMock"] }
    },
    {
      "if": { "properties": { "mode": { "const": "enterpriseProxy" } } },
      "then": { "required": ["enterpriseProxy"] }
    }
  ],
  "$defs": {
    "mode": {
      "title": "SecretsEngineMode",
      "type": "string",
      "description": "localMock (Community) resolve de um arquivo local; enterpriseProxy (Enterprise) busca na nuvem via SSO e guarda só em RAM.",
      "enum": ["localMock", "enterpriseProxy"]
    },
    "localMock": {
      "title": "LocalMockConfig",
      "type": "object",
      "required": ["activeEnvironment"],
      "additionalProperties": false,
      "properties": {
        "activeEnvironment": {
          "type": "string",
          "description": "Id do ambiente (environment.id) cujos segredos são servidos.",
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
        },
        "storageFile": {
          "type": "string",
          "description": "Caminho relativo à raiz do workspace de um arquivo JSON com os valores reais, em texto puro, no lugar do cofre local cifrado. Precisa estar no .gitignore. Sem o campo, vale o cofre local.",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+\\.json$"
        }
      }
    },
    "provider": {
      "title": "SecretsProvider",
      "type": "string",
      "enum": ["azureKeyVault", "awsSecretsManager", "hashicorpVault"]
    },
    "enterpriseProxy": {
      "title": "EnterpriseProxyConfig",
      "type": "object",
      "required": ["provider", "upstreamVaultUrl"],
      "additionalProperties": false,
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "upstreamVaultUrl": {
          "type": "string",
          "description": "URL HTTPS do cofre na nuvem.",
          "pattern": "^https://[^\\s/$.?#][^\\s]*$"
        },
        "cacheTtlSeconds": {
          "type": "integer",
          "description": "Tempo que um segredo fica no cache em memória. 0 desliga o cache.",
          "minimum": 0,
          "maximum": 86400,
          "default": 300
        },
        "enforceMemoryOnly": {
          "type": "boolean",
          "description": "Zero-Disk Footprint: segredos nunca são gravados em disco. Só pode ser true.",
          "const": true,
          "default": true
        }
      }
    }
  }
}
