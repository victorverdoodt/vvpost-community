{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "composite": true,
    "allowJs": true,
    "paths": { "@shared/*": ["./src/shared/*"], "@vvpost/plugin-sdk": ["./packages/plugin-sdk/index.d.ts"] }
  },
  "include": ["electron.vite.config.ts", "packages/core/src/**/*", "vitest.config.mts", "test/**/*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/renderer/src/modules/flow-studio/model.ts", "src/renderer/src/modules/quick-request/graphql.ts", "src/renderer/src/design-system/response/body.ts", "src/renderer/src/design-system/find/find.ts", "src/renderer/src/design-system/response/jsonpath.ts", "src/renderer/src/design-system/response/segments.ts", "src/renderer/src/design-system/response/template.ts", "src/renderer/src/design-system/response/json-locate.ts", "src/renderer/src/design-system/feedback/errors.ts", "src/renderer/src/design-system/editors/schema-form.ts", "src/renderer/src/app/workspace/explorer-tree.ts", "src/renderer/src/modules/docs/markdown-format.ts", "src/renderer/src/modules/docs/references.ts", "src/renderer/src/modules/docs/source-sync.ts", "src/renderer/src/design-system/content/markdown-lines.ts", "src/renderer/src/design-system/content/lazy-content.ts", "plugins/*/index.js", "plugins/*/lib/**/*.js", "bench/agentes/codex.mjs"],
  // Usa os módulos do renderer com DOM (atalhos, área de transferência): é checado pelo tsconfig.web.json.
  "exclude": ["test/context-menus.test.ts", "test/explorer-menus.test.ts", "test/workspace-tabs.test.ts", "test/project-switch.test.ts", "test/panel-layout.test.ts", "test/panel-dock.test.ts"]
}
