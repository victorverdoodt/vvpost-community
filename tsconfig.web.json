{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "composite": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["./src/renderer/src/**/*", "src/preload/*.d.ts", "src/shared/**/*", "test/context-menus.test.ts", "test/explorer-menus.test.ts", "test/workspace-tabs.test.ts", "test/project-switch.test.ts", "test/panel-layout.test.ts", "test/panel-dock.test.ts"]
}
