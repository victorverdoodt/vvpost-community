{
  "$schema": "https://vvpost.dev/schemas/v1/environment.json",
  "id": "homolog",
  "name": "Homologação",
  "variables": {
    "LOJA_URL": { "type": "string", "value": "http://127.0.0.1:__PORTA_HOMOLOG__" },
    "LOJA_API_KEY": { "type": "string", "value": "__REQUIRED_SECRET__", "isSecret": true, "description": "Chave do canal de venda na homologação" },
    "TRANSNORTE_API_KEY": { "type": "string", "value": "__REQUIRED_SECRET__", "isSecret": true },
    "ENTREGAJA_TOKEN": { "type": "string", "value": "__REQUIRED_SECRET__", "isSecret": true }
  }
}
