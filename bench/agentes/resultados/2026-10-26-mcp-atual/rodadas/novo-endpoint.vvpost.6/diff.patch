diff --git a/src/frete/transnorte.js b/src/frete/transnorte.js
index 7be3a23..30cf3d7 100644
--- a/src/frete/transnorte.js
+++ b/src/frete/transnorte.js
@@ -13,6 +13,16 @@ export function criarTransNorte({ fetch = globalThis.fetch, apiKey = process.env
       if (!res.ok) throw new Error(`TransNorte respondeu ${res.status}`)
       const data = await res.json()
       return { valorCentavos: Math.round(data.valor * 100), prazoDias: data.prazoDiasUteis, transportadora: 'transnorte' }
+    },
+
+    // Devolve { codigo, eventos } como a TransNorte; undefined quando ela não conhece o código (404).
+    async rastrear(codigo) {
+      const res = await fetch(`${BASE}/rastreamentos/${encodeURIComponent(codigo)}`, {
+        headers: { 'x-api-key': apiKey ?? '' }
+      })
+      if (res.status === 404) return undefined
+      if (!res.ok) throw new Error(`TransNorte respondeu ${res.status}`)
+      return res.json()
     }
   }
 }
