diff --git a/test/pedidos.test.js b/test/pedidos.test.js
index e4c732c..0d0c7d3 100644
--- a/test/pedidos.test.js
+++ b/test/pedidos.test.js
@@ -57,3 +57,48 @@ test('POST /pedidos devolve 503 quando nenhuma transportadora cota', async () =>
   assert.equal(r.status, 503)
   assert.equal(r.body.erro.codigo, 'FRETE_INDISPONIVEL')
 })
+
+const novoPedido = (app) => app.handle('POST', '/pedidos', { itens: [{ produtoId: 'p-100' }], cep: '01310100' })
+const appComTransnorte = (transnorte) => criarApp({ frete: freteFixo(), transnorte, agora: agoraFixo })
+
+test('GET /pedidos/{id}/rastreio devolve os eventos da TransNorte', async () => {
+  const eventos = [{ quando: '2026-03-02T09:00:00Z', descricao: 'Objeto postado', cidade: 'São Paulo' }]
+  const chamadas = []
+  const app = appComTransnorte({
+    rastrear: async (codigo) => {
+      chamadas.push(codigo)
+      return { codigo, eventos }
+    }
+  })
+  const { body: pedido } = await novoPedido(app)
+  const r = await app.handle('GET', `/pedidos/${pedido.id}/rastreio`)
+  assert.equal(r.status, 200)
+  assert.deepEqual(r.body, { codigo: pedido.id, eventos })
+  assert.deepEqual(chamadas, [pedido.id])
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 PEDIDO_NAO_ENCONTRADO', async () => {
+  const r = await appComTransnorte({ rastrear: async () => undefined }).handle('GET', '/pedidos/ped-0/rastreio')
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'PEDIDO_NAO_ENCONTRADO')
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 RASTREIO_NAO_ENCONTRADO quando a TransNorte não conhece o código', async () => {
+  const app = appComTransnorte({ rastrear: async () => undefined })
+  const { body: pedido } = await novoPedido(app)
+  const r = await app.handle('GET', `/pedidos/${pedido.id}/rastreio`)
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_NAO_ENCONTRADO')
+})
+
+test('GET /pedidos/{id}/rastreio devolve 503 RASTREIO_INDISPONIVEL quando a TransNorte falha', async () => {
+  const app = appComTransnorte({
+    rastrear: async () => {
+      throw new Error('TransNorte respondeu 500')
+    }
+  })
+  const { body: pedido } = await novoPedido(app)
+  const r = await app.handle('GET', `/pedidos/${pedido.id}/rastreio`)
+  assert.equal(r.status, 503)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_INDISPONIVEL')
+})
