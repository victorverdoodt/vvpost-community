diff --git a/test/rastreio.test.js b/test/rastreio.test.js
new file mode 100644
index 0000000..9fa72c6
--- /dev/null
+++ b/test/rastreio.test.js
@@ -0,0 +1,54 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { criarApp } from '../src/app.js'
+import { criarTransNorte } from '../src/frete/transnorte.js'
+import { freteFixo, fetchFalso, agoraFixo } from './apoio.js'
+
+const rastreioTn = { codigo: 'ped-1001', eventos: [{ quando: '2026-03-02T09:00:00Z', descricao: 'Objeto postado', cidade: 'São Paulo' }] }
+
+async function appComPedido(transnorte) {
+  const app = criarApp({ frete: freteFixo(), transnorte, agora: agoraFixo })
+  const p = await app.handle('POST', '/pedidos', { itens: [{ produtoId: 'p-100' }], cep: '01310100' })
+  return { app, id: p.body.id }
+}
+
+test('TransNorte rastreia pelo código e devolve null no 404', async () => {
+  const ok = fetchFalso(rastreioTn)
+  assert.deepEqual(await criarTransNorte({ fetch: ok, apiKey: 'k' }).rastrear('ped-1001'), rastreioTn)
+  assert.match(ok.chamadas[0].url, /\/rastreamentos\/ped-1001$/)
+  assert.equal(ok.chamadas[0].init.headers['x-api-key'], 'k')
+  assert.equal(await criarTransNorte({ fetch: fetchFalso({}, { status: 404 }) }).rastrear('x'), null)
+  await assert.rejects(criarTransNorte({ fetch: fetchFalso({}, { status: 500 }) }).rastrear('x'), /500/)
+})
+
+test('GET /pedidos/{id}/rastreio devolve os eventos da TransNorte', async () => {
+  const codigos = []
+  const { app, id } = await appComPedido({ rastrear: async (c) => { codigos.push(c); return rastreioTn } })
+  const r = await app.handle('GET', `/pedidos/${id}/rastreio`)
+  assert.equal(r.status, 200)
+  assert.deepEqual(r.body, rastreioTn)
+  assert.deepEqual(codigos, [id])
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 PEDIDO_NAO_ENCONTRADO sem consultar a TransNorte', async () => {
+  let chamou = false
+  const { app } = await appComPedido({ rastrear: async () => { chamou = true } })
+  const r = await app.handle('GET', '/pedidos/ped-1/rastreio')
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'PEDIDO_NAO_ENCONTRADO')
+  assert.equal(chamou, false)
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 RASTREIO_NAO_ENCONTRADO quando a TransNorte não conhece o código', async () => {
+  const { app, id } = await appComPedido({ rastrear: async () => null })
+  const r = await app.handle('GET', `/pedidos/${id}/rastreio`)
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_NAO_ENCONTRADO')
+})
+
+test('GET /pedidos/{id}/rastreio devolve 503 quando a TransNorte falha', async () => {
+  const { app, id } = await appComPedido({ rastrear: async () => { throw new Error('TransNorte respondeu 500') } })
+  const r = await app.handle('GET', `/pedidos/${id}/rastreio`)
+  assert.equal(r.status, 503)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_INDISPONIVEL')
+})
