diff --git a/test/pedidos.test.js b/test/pedidos.test.js
index e4c732c..4ebabf4 100644
--- a/test/pedidos.test.js
+++ b/test/pedidos.test.js
@@ -57,3 +57,52 @@ test('POST /pedidos devolve 503 quando nenhuma transportadora cota', async () =>
   assert.equal(r.status, 503)
   assert.equal(r.body.erro.codigo, 'FRETE_INDISPONIVEL')
 })
+
+const rastreioFixo = (resultado) => ({
+  chamadas: [],
+  async rastrear(codigo) {
+    this.chamadas.push(codigo)
+    return resultado
+  }
+})
+const criarUm = (app) => app.handle('POST', '/pedidos', { itens: [{ produtoId: 'p-100' }], cep: '01310100' })
+
+test('GET /pedidos/{id}/rastreio devolve os eventos da TransNorte', async () => {
+  const eventos = [{ quando: '2026-03-02T09:00:00Z', descricao: 'Objeto postado', cidade: 'São Paulo' }]
+  const rastreio = rastreioFixo({ codigo: 'ped-1001', eventos })
+  const app = criarApp({ frete: freteFixo(), rastreio, agora: agoraFixo })
+  const { body: pedido } = await criarUm(app)
+  const r = await app.handle('GET', `/pedidos/${pedido.id}/rastreio`)
+  assert.equal(r.status, 200)
+  assert.deepEqual(r.body, { codigo: 'ped-1001', eventos })
+  assert.deepEqual(rastreio.chamadas, [pedido.id])
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 PEDIDO_NAO_ENCONTRADO', async () => {
+  const rastreio = rastreioFixo(null)
+  const r = await criarApp({ frete: freteFixo(), rastreio }).handle('GET', '/pedidos/ped-9/rastreio')
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'PEDIDO_NAO_ENCONTRADO')
+  assert.equal(rastreio.chamadas.length, 0)
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 RASTREIO_NAO_ENCONTRADO se a TransNorte não conhece', async () => {
+  const app = criarApp({ frete: freteFixo(), rastreio: rastreioFixo(null), agora: agoraFixo })
+  const { body: pedido } = await criarUm(app)
+  const r = await app.handle('GET', `/pedidos/${pedido.id}/rastreio`)
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_NAO_ENCONTRADO')
+})
+
+test('GET /pedidos/{id}/rastreio devolve 503 se a TransNorte falha', async () => {
+  const rastreio = {
+    async rastrear() {
+      throw new Error('TransNorte respondeu 500')
+    }
+  }
+  const app = criarApp({ frete: freteFixo(), rastreio, agora: agoraFixo })
+  const { body: pedido } = await criarUm(app)
+  const r = await app.handle('GET', `/pedidos/${pedido.id}/rastreio`)
+  assert.equal(r.status, 503)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_INDISPONIVEL')
+})
