+
+const rastreioFalso = (fn) => ({ rastrear: fn })
+const novoPedido = (app) => app.handle('POST', '/pedidos', { itens: [{ produtoId: 'p-100' }], cep: '01310100' })
+
+test('GET /pedidos/{id}/rastreio devolve os eventos da TransNorte com o id como código', async () => {
+  const chamadas = []
+  const resposta = { codigo: 'ped-1001', eventos: [{ quando: '2026-03-02T09:00:00Z', descricao: 'Objeto postado', cidade: 'São Paulo' }] }
+  const rastreio = rastreioFalso(async (codigo) => { chamadas.push(codigo); return resposta })
+  const app = criarApp({ frete: freteFixo(), rastreio, agora: agoraFixo })
+  const p = await novoPedido(app)
+  const r = await app.handle('GET', `/pedidos/${p.body.id}/rastreio`)
+  assert.equal(r.status, 200)
+  assert.deepEqual(r.body, resposta)
+  assert.deepEqual(chamadas, [p.body.id])
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 PEDIDO_NAO_ENCONTRADO sem consultar a TransNorte', async () => {
+  let chamou = false
+  const rastreio = rastreioFalso(async () => { chamou = true })
+  const r = await criarApp({ frete: freteFixo(), rastreio }).handle('GET', '/pedidos/ped-1/rastreio')
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'PEDIDO_NAO_ENCONTRADO')
+  assert.equal(chamou, false)
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 RASTREIO_NAO_ENCONTRADO quando a TransNorte não conhece o código', async () => {
