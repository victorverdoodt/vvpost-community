+  const p = await novoPedido(app)
+  const r = await app.handle('GET', `/pedidos/${p.body.id}/rastreio`)
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_NAO_ENCONTRADO')
+})
+
+test('GET /pedidos/{id}/rastreio devolve 503 RASTREIO_INDISPONIVEL quando a TransNorte falha', async () => {
+  const rastreio = rastreioFalso(async () => { throw new Error('TransNorte respondeu 500') })
