diff --git a/test/rastreio.test.js b/test/rastreio.test.js
new file mode 100644
index 0000000..823639f
--- /dev/null
+++ b/test/rastreio.test.js
@@ -0,0 +1,56 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { criarApp } from '../src/app.js'
+import { criarTransNorte } from '../src/frete/transnorte.js'
+import { freteFixo, fetchFalso, agoraFixo } from './apoio.js'
+
+const novoPedido = (app) => app.handle('POST', '/pedidos', { itens: [{ produtoId: 'p-100' }], cep: '01310100' })
+const novoApp = (rastreio) => criarApp({ frete: freteFixo(), rastreio, agora: agoraFixo })
+
+test('GET /pedidos/{id}/rastreio devolve os eventos da TransNorte', async () => {
+  const rastreamento = { codigo: 'ped-1001', eventos: [{ quando: '2026-03-02T09:00:00Z', descricao: 'Objeto postado', cidade: 'São Paulo' }] }
+  const codigos = []
+  const app = novoApp({ rastrear: async (codigo) => (codigos.push(codigo), rastreamento) })
+  const { body: pedido } = await novoPedido(app)
+  const r = await app.handle('GET', `/pedidos/${pedido.id}/rastreio`)
+  assert.equal(r.status, 200)
+  assert.deepEqual(r.body, rastreamento)
+  assert.deepEqual(codigos, [pedido.id])
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 PEDIDO_NAO_ENCONTRADO sem consultar a TransNorte', async () => {
+  const app = novoApp({ rastrear: async () => assert.fail('não deveria consultar a TransNorte') })
+  const r = await app.handle('GET', '/pedidos/ped-9999/rastreio')
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'PEDIDO_NAO_ENCONTRADO')
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 RASTREIO_NAO_ENCONTRADO quando a TransNorte não conhece o código', async () => {
+  const app = novoApp({ rastrear: async () => null })
+  const { body: pedido } = await novoPedido(app)
+  const r = await app.handle('GET', `/pedidos/${pedido.id}/rastreio`)
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_NAO_ENCONTRADO')
+})
+
+test('GET /pedidos/{id}/rastreio devolve 503 RASTREIO_INDISPONIVEL se a TransNorte falhar', async () => {
+  const app = novoApp({ rastrear: async () => { throw new Error('TransNorte respondeu 500') } })
+  const { body: pedido } = await novoPedido(app)
+  const r = await app.handle('GET', `/pedidos/${pedido.id}/rastreio`)
+  assert.equal(r.status, 503)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_INDISPONIVEL')
+})
+
+test('TransNorte rastreia por GET /rastreamentos/{codigo}', async () => {
+  const resposta = { codigo: 'ped-1001', eventos: [] }
+  const fetch = fetchFalso(resposta)
+  const r = await criarTransNorte({ fetch, apiKey: 'k' }).rastrear('ped-1001')
+  assert.deepEqual(r, resposta)
+  assert.match(fetch.chamadas[0].url, /\/rastreamentos\/ped-1001$/)
+  assert.equal(fetch.chamadas[0].init.headers['x-api-key'], 'k')
+})
+
+test('TransNorte devolve null para código desconhecido (404) e falha nos demais erros', async () => {
+  assert.equal(await criarTransNorte({ fetch: fetchFalso({}, { status: 404 }) }).rastrear('x'), null)
+  await assert.rejects(criarTransNorte({ fetch: fetchFalso({}, { status: 500 }) }).rastrear('x'), /500/)
+})
