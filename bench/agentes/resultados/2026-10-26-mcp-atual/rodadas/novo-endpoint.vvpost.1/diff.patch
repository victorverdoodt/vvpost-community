diff --git a/test/pedidos.test.js b/test/pedidos.test.js
index e4c732c..1305873 100644
--- a/test/pedidos.test.js
+++ b/test/pedidos.test.js
@@ -57,3 +57,39 @@ test('POST /pedidos devolve 503 quando nenhuma transportadora cota', async () =>
   assert.equal(r.status, 503)
   assert.equal(r.body.erro.codigo, 'FRETE_INDISPONIVEL')
 })
+
+const comTransNorte = (rastrear) => criarApp({ frete: freteFixo(), transnorte: { rastrear }, agora: agoraFixo })
+const novoPedido = (app) => app.handle('POST', '/pedidos', { itens: [{ produtoId: 'p-100' }], cep: '01310100' })
+
+test('GET /pedidos/{id}/rastreio devolve os eventos da TransNorte', async () => {
+  const rastreio = { codigo: 'ped-1001', eventos: [{ quando: '2026-03-02T09:00:00Z', descricao: 'Objeto postado', cidade: 'São Paulo' }] }
+  const codigos = []
+  const app = comTransNorte(async (codigo) => (codigos.push(codigo), rastreio))
+  const p = await novoPedido(app)
+  const r = await app.handle('GET', '/pedidos/' + p.body.id + '/rastreio')
+  assert.equal(r.status, 200)
+  assert.deepEqual(r.body, rastreio)
+  assert.deepEqual(codigos, [p.body.id])
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 para pedido inexistente', async () => {
+  const r = await comTransNorte(async () => assert.fail('não deveria consultar')).handle('GET', '/pedidos/ped-9/rastreio')
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'PEDIDO_NAO_ENCONTRADO')
+})
+
+test('GET /pedidos/{id}/rastreio devolve 404 quando a TransNorte não conhece o código', async () => {
+  const app = comTransNorte(async () => undefined)
+  const p = await novoPedido(app)
+  const r = await app.handle('GET', '/pedidos/' + p.body.id + '/rastreio')
+  assert.equal(r.status, 404)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_NAO_ENCONTRADO')
+})
+
+test('GET /pedidos/{id}/rastreio devolve 503 quando a TransNorte falha', async () => {
+  const app = comTransNorte(async () => { throw new Error('TransNorte respondeu 500') })
+  const p = await novoPedido(app)
+  const r = await app.handle('GET', '/pedidos/' + p.body.id + '/rastreio')
+  assert.equal(r.status, 503)
+  assert.equal(r.body.erro.codigo, 'RASTREIO_INDISPONIVEL')
+})
