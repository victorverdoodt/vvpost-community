meta {
  name: Listar pedidos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/pedidos?status=aberto
  body: none
  auth: inherit
}

params:query {
  status: aberto
  ~debug: 1
}

assert {
  res.status: eq 200
  res.body.itens: isArray
  res.headers.content-type: contains json
  res.body.total: gte 0
  res.foo: eq 1
}

script:post-response {
  bru.setEnvVar("primeiro", res.getBody().itens[0].id);
}

tests {
  test("tem itens", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
