{
  "$schema": "https://vvpost.dev/schemas/v1/flow.json",
  "id": "connector.payments.v1.create_charge",
  "name": "Criar cobrança",
  "extends": "connector.payments.v1",
  "order": 1,
  "nodes": [
    {
      "id": "request",
      "name": "Request",
      "type": "request",
      "request": {
        "method": "POST",
        "url": "/charges",
        "body": {
          "amount": 150,
          "currency": "BRL",
          "customer_id": "cust_123",
          "method": "PIX"
        },
        "bodySchema": {
          "type": "object",
          "required": [
            "amount",
            "currency",
            "customer_id",
            "method"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "description": "Valor em reais"
            },
            "currency": {
              "type": "string",
              "enum": [
                "BRL",
                "USD"
              ]
            },
            "customer_id": {
              "type": "string"
            },
            "method": {
              "type": "string",
              "enum": [
                "PIX",
                "CREDIT_CARD"
              ]
            }
          }
        }
      }
    }
  ],
  "scenarios": [
    {
      "id": "tc_pix_ok",
      "name": "Sucesso com PIX",
      "assertions": [
        {
          "target": "status",
          "operator": "equals",
          "expected": 201
        },
        {
          "target": "body.status",
          "operator": "equals",
          "expected": "approved"
        },
        {
          "target": "responseTimeMs",
          "operator": "lessThan",
          "expected": 2000
        }
      ]
    },
    {
      "id": "tc_invalid_amount",
      "name": "Valor inválido",
      "overrides": {
        "body": {
          "amount": -10,
          "currency": "BRL",
          "customer_id": "cust_123",
          "method": "PIX"
        }
      },
      "assertions": [
        {
          "target": "status",
          "operator": "equals",
          "expected": 400
        },
        {
          "target": "body.error",
          "operator": "equals",
          "expected": "INVALID_AMOUNT"
        }
      ]
    },
    {
      "id": "tc_expected_failure",
      "name": "Cartão recusado (falha de propósito)",
      "overrides": {
        "body": {
          "amount": 99999,
          "currency": "BRL",
          "customer_id": "cust_123",
          "method": "CREDIT_CARD"
        }
      },
      "assertions": [
        {
          "target": "status",
          "operator": "equals",
          "expected": 201
        },
        {
          "target": "body.status",
          "operator": "equals",
          "expected": "approved"
        }
      ]
    }
  ]
}
